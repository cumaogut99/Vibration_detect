  let cbMin=0,cbMax=1;
  if(ST.colorBy!=='series'&&ST.colorBy!=='none'){const vals=DATA.map(d=>d[ST.colorBy]);cbMin=Math.min(...vals);cbMax=Math.max(...vals);}
  let sbMin=0,sbMax=1;if(ST.sizeBy!=='none'){const vals=DATA.map(d=>d[ST.sizeBy]);sbMin=Math.min(...vals);sbMax=Math.max(...vals);}
  const sel=ST.selection;
  for(const g of groups){for(const r of g.rows){const X=tx(r[ST.xCol]),Y=ty(r[ST.yCol]);
    if(X<PAD.l-5||X>W-PAD.r+5||Y<PAD.t-5||Y>H-PAD.b+5)continue;
    let s=ST.ptSize;if(ST.sizeBy!=='none')s=3+10*((r[ST.sizeBy]-sbMin)/((sbMax-sbMin)||1));
