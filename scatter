  ctx.beginPath();for(let i=0;i<=N;i++){const X=tx(line[i][0]),Y=ty(line[i][1]);i===0?ctx.moveTo(X,Y):ctx.lineTo(X,Y);}
  ctx.strokeStyle=color;ctx.lineWidth=2.2;ctx.stroke();return {fit,resStd};}
function draw(){drawAxes();const groups=seriesGroups();
