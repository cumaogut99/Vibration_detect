  ctx.setLineDash([]);ctx.globalAlpha=1;ctx.restore();}
function fitFor(rows){const xs=rows.map(r=>r[ST.xCol]),ys=rows.map(r=>r[ST.yCol]);if(rows.length<3)return null;
