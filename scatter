<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>MachinePulseAI — Scatter Plot (Design Mockup)</title>
<style>
  :root {
    --bg:        #1b1e24;
    --panel:     #23272f;
    --panel-2:   #2b303a;
    --rail:      #1d2128;
    --border:    #353b46;
    --text:      #d7dce3;
    --text-dim:  #8b93a1;
    --accent:    #4ea1ff;
    --accent-2:  #ffb454;
    --good:      #4ec97a;
    --bad:       #ff6b6b;
    --grid:      #2e333d;
  }
  * { box-sizing: border-box; }
  html, body {
    margin: 0; height: 100%;
    background: var(--bg); color: var(--text);
    font-family: "Segoe UI", Roboto, system-ui, sans-serif; font-size: 13px;
    overflow: hidden;
  }
  .app { display: flex; flex-direction: column; height: 100vh; }

  /* ---- Toolbar ---- */
  .toolbar {
    display: flex; align-items: center; gap: 10px;
    padding: 7px 12px; background: var(--panel);
    border-bottom: 1px solid var(--border);
  }
  .toolbar .title { font-weight: 600; font-size: 14px; letter-spacing: .2px; }
  .toolbar .title .badge {
    font-size: 10px; color: var(--text-dim); border: 1px solid var(--border);
    border-radius: 4px; padding: 1px 6px; margin-left: 8px; font-weight: 400;
  }
  .toolbar .spacer { flex: 1; }
  .tbtn {
    background: var(--panel-2); border: 1px solid var(--border); color: var(--text);
    padding: 5px 10px; border-radius: 5px; cursor: pointer; font-size: 12px;
  }
  .tbtn:hover { border-color: var(--accent); }
  .tbtn.active { background: var(--accent); color: #0c0f14; border-color: var(--accent); }

  /* ---- Body ---- */
  .body { display: flex; flex: 1; min-height: 0; }

  /* ---- Left rail (icon buttons, like Time Graphics) ---- */
  .rail {
    width: 56px; background: var(--rail); border-right: 1px solid var(--border);
    display: flex; flex-direction: column; align-items: center; padding-top: 6px; gap: 2px;
  }
  .rail button {
    width: 48px; height: 50px; background: transparent; border: none; color: var(--text-dim);
    cursor: pointer; border-radius: 7px; display: flex; flex-direction: column;
    align-items: center; justify-content: center; gap: 3px; font-size: 9.5px;
  }
  .rail button .ico { font-size: 18px; line-height: 1; }
  .rail button:hover { background: var(--panel-2); color: var(--text); }
  .rail button.active { background: var(--panel); color: var(--accent); box-shadow: inset 3px 0 0 var(--accent); }

  /* ---- Left drawer (panel that opens) ---- */
  .drawer {
    width: 256px; background: var(--panel); border-right: 1px solid var(--border);
    overflow-y: auto; transition: width .12s ease; flex-shrink: 0;
  }
  .drawer.collapsed { width: 0; border-right: none; overflow: hidden; }
  .drawer-head {
    display:flex; align-items:center; justify-content:space-between;
    padding: 10px 12px; border-bottom: 1px solid var(--border);
    font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing:.5px; color: var(--text-dim);
  }
  .drawer-head .x { cursor:pointer; color:var(--text-dim); font-size:15px; }
  .drawer-head .x:hover { color:var(--text); }
  .panel { display: none; }
  .panel.active { display: block; }

  .section { padding: 10px 12px; border-bottom: 1px solid var(--grid); }
  .row { display: flex; align-items: center; justify-content: space-between; margin: 6px 0; gap: 8px; }
  .row label { color: var(--text-dim); font-size: 12px; }
  select, input[type="number"] {
    background: var(--panel-2); color: var(--text); border: 1px solid var(--border);
    border-radius: 5px; padding: 4px 6px; font-size: 12px; max-width: 132px;
  }
  input[type="range"] { width: 118px; accent-color: var(--accent); }
  input[type="checkbox"] { accent-color: var(--accent); }
  .val { color: var(--text); font-variant-numeric: tabular-nums; min-width: 30px; text-align: right; }
  .hintnote { color: var(--text-dim); font-size: 11px; line-height:1.4; }

  /* ---- Channels list (now on the LEFT) ---- */
  .chan {
    display: flex; align-items: center; gap: 8px; padding: 7px 12px;
    border-bottom: 1px solid var(--grid);
  }
  .chan .swatch { width: 11px; height: 11px; border-radius: 3px; flex-shrink: 0; background:#3a4150; }
  .chan .name { flex: 1; }
  .assign { display:flex; gap:4px; }
  .assign button {
    width: 22px; height: 22px; border-radius: 5px; border: 1px solid var(--border);
    background: var(--panel-2); color: var(--text-dim); cursor: pointer; font-size: 11px; font-weight:600;
  }
  .assign button.x { color: var(--accent); border-color: var(--accent); background: rgba(78,161,255,.12); }
  .assign button.y { color: var(--accent-2); border-color: var(--accent-2); background: rgba(255,180,84,.12); }
  .series-row {
    display:flex; align-items:center; gap:8px; padding:7px 12px; border-bottom:1px solid var(--grid);
  }
  .series-row .swatch { width:12px;height:12px;border-radius:3px;flex-shrink:0; }
  .series-row .name { flex:1; }
  .series-row .count { color:var(--text-dim); font-size:11px; }
  .grp-title { padding: 9px 12px 4px; font-size:11px; text-transform:uppercase; letter-spacing:.5px; color:var(--text-dim); font-weight:600; }

  /* ---- Center plot ---- */
  .pane-center { flex: 1; min-width: 0; position: relative; display:flex; flex-direction:column; }
  .plot-wrap { flex: 1; position: relative; min-height: 0; }
  canvas { position: absolute; inset: 0; width: 100%; height: 100%; display:block; }
  #overlay { cursor: crosshair; }
  .readout {
    position: absolute; left: 12px; bottom: 10px;
    background: rgba(20,23,28,.85); border: 1px solid var(--border); border-radius: 6px;
    padding: 6px 10px; font-size: 12px; color: var(--text-dim);
    font-variant-numeric: tabular-nums; pointer-events: none;
  }
  .readout b { color: var(--text); }
  .tooltip {
    position: absolute; pointer-events: none; display: none; z-index: 20;
    background: rgba(20,23,28,.95); border: 1px solid var(--accent); border-radius: 6px;
    padding: 7px 9px; font-size: 12px; box-shadow: 0 4px 14px rgba(0,0,0,.4);
    font-variant-numeric: tabular-nums; white-space: nowrap;
  }
  .tooltip .k { color: var(--text-dim); }
  .legend {
    position: absolute; right: 12px; top: 10px;
    background: rgba(20,23,28,.7); border: 1px solid var(--border); border-radius: 6px;
    padding: 6px 9px; font-size: 12px; pointer-events: none;
  }
  .legend .lrow { display:flex; align-items:center; gap:7px; margin: 2px 0; }
  .legend .swatch { width:12px;height:12px;border-radius:3px; }
  .hint {
    position:absolute; left:50%; transform:translateX(-50%); top:10px;
    background: rgba(78,161,255,.12); border:1px solid var(--accent); color:var(--accent);
    border-radius: 14px; padding: 4px 12px; font-size: 11.5px; pointer-events:none;
  }

  /* ---- Right tabs ---- */
  .pane-right { width: 296px; background: var(--panel); border-left: 1px solid var(--border); display:flex; flex-direction:column; }
  .tabs { display: flex; border-bottom: 1px solid var(--border); }
  .tab { flex: 1; text-align: center; padding: 8px 4px; cursor: pointer; font-size: 12px; color: var(--text-dim); border-bottom: 2px solid transparent; }
  .tab.active { color: var(--text); border-bottom-color: var(--accent); }
  .tab-body { flex: 1; overflow-y: auto; padding: 4px 0; }
  table { width: 100%; border-collapse: collapse; font-size: 12px; }
  th, td { text-align: right; padding: 5px 12px; border-bottom: 1px solid var(--grid); }
  th:first-child, td:first-child { text-align: left; color: var(--text-dim); }
  td { font-variant-numeric: tabular-nums; }
  .stat-group-title { padding: 9px 12px 4px; font-size: 11px; text-transform: uppercase; letter-spacing:.5px; color: var(--text-dim); font-weight: 600; }
  .pill { font-size: 11px; padding: 1px 7px; border-radius: 10px; }
  .pill.good { background: rgba(78,201,122,.15); color: var(--good); }
  .pill.warn { background: rgba(255,180,84,.15); color: var(--accent-2); }
  .pill.bad  { background: rgba(255,107,107,.15); color: var(--bad); }
  .insight { display: flex; gap: 9px; padding: 10px 12px; border-bottom: 1px solid var(--grid); line-height: 1.45; }
  .insight .ico { font-size: 15px; flex-shrink: 0; }
  .insight .txt b { color: #fff; }
  .insight.warn { background: rgba(255,180,84,.05); }
  .insight.bad  { background: rgba(255,107,107,.06); }
</style>
</head>
<body>
<div class="app">

  <!-- ================= TOOLBAR ================= -->
  <div class="toolbar">
    <span class="title">Scatter Plot <span class="badge">Bivariate Explorer · Design Mockup</span></span>
    <span class="spacer"></span>
    <button class="tbtn" id="btnSelMode" title="Lasso select for cross-filtering">⬚ Lasso Select</button>
    <button class="tbtn" id="btnClearSel">Clear Selection</button>
    <button class="tbtn" id="btnReset">Reset View</button>
    <button class="tbtn" title="Mock only">⤓ Export</button>
  </div>

  <div class="body">

    <!-- ================= LEFT RAIL (toggle buttons) ================= -->
    <div class="rail" id="rail">
      <button data-panel="channels" class="active"><span class="ico">📑</span>Channels</button>
      <button data-panel="axes"><span class="ico">📐</span>Axes</button>
      <button data-panel="encoding"><span class="ico">🎨</span>Encode</button>
      <button data-panel="markers"><span class="ico">⬤</span>Markers</button>
      <button data-panel="density"><span class="ico">🌫️</span>Density</button>
      <button data-panel="trend"><span class="ico">📈</span>Trend</button>
      <button data-panel="reference"><span class="ico">📏</span>Limits</button>
    </div>

    <!-- ================= LEFT DRAWER (panel content) ================= -->
    <div class="drawer" id="drawer">
      <div class="drawer-head"><span id="drawerTitle">Channels</span><span class="x" id="drawerX">✕</span></div>

      <!-- CHANNELS panel -->
      <div class="panel active" data-panel="channels">
        <div class="grp-title">Channels — click X / Y to assign</div>
        <div id="chanList"></div>
        <div class="grp-title">Series</div>
        <div id="seriesList"></div>
      </div>

      <!-- AXES panel -->
      <div class="panel" data-panel="axes">
        <div class="section">
          <div class="row"><label>X Channel</label><select id="xCol"></select></div>
          <div class="row"><label>Y Channel</label><select id="yCol"></select></div>
          <div class="row"><label>X Log scale</label><input type="checkbox" id="xLog"></div>
          <div class="row"><label>Y Log scale</label><input type="checkbox" id="yLog"></div>
        </div>
      </div>

      <!-- ENCODING panel -->
      <div class="panel" data-panel="encoding">
        <div class="section">
          <div class="row"><label>Group by</label>
            <select id="groupBy">
              <option value="bearing" selected>Bearing (category)</option>
              <option value="none">None (single series)</option>
            </select></div>
          <div class="row"><label>Color by</label>
            <select id="colorBy">
              <option value="series" selected>Series</option>
              <option value="Temperature">Temperature (continuous)</option>
              <option value="none">None</option>
            </select></div>
          <div class="row"><label>Size by</label>
            <select id="sizeBy">
              <option value="none" selected>None</option>
              <option value="Order-2 Amp">Order-2 Amp</option>
            </select></div>
          <div class="hintnote">Color/size-by extra channels turns the scatter into a 4-dimensional explorer (bubble chart).</div>
        </div>
      </div>

      <!-- MARKERS panel -->
      <div class="panel" data-panel="markers">
        <div class="section">
          <div class="row"><label>Shape</label>
            <select id="shape">
              <option value="circle" selected>Circle</option>
              <option value="square">Square</option>
              <option value="diamond">Diamond</option>
              <option value="triangle">Triangle</option>
              <option value="cross">Cross</option>
            </select></div>
          <div class="row"><label>Size</label>
            <input type="range" id="ptSize" min="2" max="14" value="5"><span class="val" id="ptSizeV">5</span></div>
          <div class="row"><label>Opacity</label>
            <input type="range" id="opacity" min="10" max="100" value="80"><span class="val" id="opacityV">80%</span></div>
        </div>
      </div>

      <!-- DENSITY panel -->
      <div class="panel" data-panel="density">
        <div class="section">
          <div class="row"><label>Mode</label>
            <select id="densMode">
              <option value="points" selected>Points only</option>
              <option value="hexbin">Hexbin density</option>
              <option value="contour">KDE contours</option>
            </select></div>
          <div class="row"><label>95% Density ellipse</label><input type="checkbox" id="ellipse"></div>
          <div class="hintnote">Density layer solves over-plotting on 50k+ points (JMP Graph Builder / Spotfire / Datashader).</div>
        </div>
      </div>

      <!-- TREND panel -->
      <div class="panel" data-panel="trend">
        <div class="section">
          <div class="row"><label>Model</label>
            <select id="regModel">
              <option value="none">None</option>
              <option value="ols" selected>Linear (OLS)</option>
              <option value="robust">Robust (Theil–Sen)</option>
              <option value="poly2">Polynomial (deg 2)</option>
              <option value="poly3">Polynomial (deg 3)</option>
              <option value="loess">LOESS (local)</option>
            </select></div>
          <div class="row"><label>Confidence band (95%)</label><input type="checkbox" id="ciBand" checked></div>
          <div class="row"><label>Per-series fit</label><input type="checkbox" id="perSeries" checked></div>
          <div class="row"><label>Mark residual outliers</label><input type="checkbox" id="markOutliers" checked></div>
          <div class="hintnote">Theil–Sen is robust to outliers (measurement spikes); LOESS captures non-linear trends.</div>
        </div>
      </div>

      <!-- REFERENCE panel -->
      <div class="panel" data-panel="reference">
        <div class="section">
          <div class="row"><label>Y spec limit (USL)</label>
            <input type="number" id="usl" value="0" step="0.1" style="max-width:80px"></div>
          <div class="hintnote">Set &gt; 0 to draw a limit line &amp; flag exceedances (semiconductor / SPC pattern).</div>
        </div>
      </div>
    </div>

    <!-- ================= CENTER PLOT ================= -->
    <div class="pane-center">
      <div class="plot-wrap" id="plotWrap">
        <canvas id="plot"></canvas>
        <canvas id="overlay"></canvas>
        <div class="legend" id="legend"></div>
        <div class="readout" id="readout">X: — &nbsp; Y: —</div>
        <div class="tooltip" id="tooltip"></div>
        <div class="hint" id="hint" style="display:none">Drag to lasso-select points → cross-filters all linked views</div>
      </div>
    </div>

    <!-- ================= RIGHT TABS ================= -->
    <div class="pane-right">
      <div class="tabs">
        <div class="tab active" data-tab="stats">Statistics</div>
        <div class="tab" data-tab="insights">Insights</div>
      </div>
      <div class="tab-body" id="tab-stats"></div>
      <div class="tab-body" id="tab-insights" style="display:none"></div>
    </div>

  </div>
</div>

<script>
/* =====================================================================
   MachinePulseAI — Scatter Plot UI design mockup
   Pure client-side. Synthetic measurement-style data. No backend.
   Layout: left icon rail toggles left drawer panels (Time-Graphics style);
   channels live on the LEFT. Right pane = Statistics + auto Insights.
   ===================================================================== */

// ---------- 1. Synthetic dataset ----------
const SERIES = [
  { key:'A', name:'Bearing A', color:'#4ea1ff' },
  { key:'B', name:'Bearing B', color:'#ffb454' },
  { key:'C', name:'Bearing C', color:'#b07cff' },
];
const CHANNELS = ['RPM','Load','Vibration RMS','Temperature','Order-2 Amp'];

function randn(){ let u=0,v=0; while(!u)u=Math.random(); while(!v)v=Math.random();
  return Math.sqrt(-2*Math.log(u))*Math.cos(2*Math.PI*v); }

const DATA = [];
const seriesParams = {
  A:{ n:220, base:0.8, slope:0.0011, noise:0.45, tempK:0.02 },
  B:{ n:200, base:1.4, slope:0.0016, noise:0.6,  tempK:0.028 },
  C:{ n:170, base:2.2, slope:0.0024, noise:0.9,  tempK:0.04 },
};
for (const s of SERIES){
  const p=seriesParams[s.key];
  for(let i=0;i<p.n;i++){
    const rpm=600+Math.random()*5400, load=20+Math.random()*80;
    let vib=p.base+p.slope*rpm+load*0.004+randn()*p.noise;
    if(Math.random()<0.025) vib+=(2+Math.random()*5)*(Math.random()<.5?1:-1);
    vib=Math.max(0.05,vib);
    const temp=35+rpm*p.tempK*0.01+load*0.15+randn()*3;
    const ord2=Math.abs(vib*0.4+randn()*0.2);
    DATA.push({series:s.key,'RPM':rpm,'Load':load,'Vibration RMS':vib,'Temperature':temp,'Order-2 Amp':ord2});
  }
}

// ---------- 2. State ----------
const ST = {
  xCol:'RPM', yCol:'Vibration RMS', groupBy:'bearing',
  colorBy:'series', sizeBy:'none', shape:'circle',
  ptSize:5, opacity:0.8, densMode:'points', ellipse:false,
  regModel:'ols', ciBand:true, perSeries:true, markOutliers:true,
  xLog:false, yLog:false, usl:0,
  selMode:false, selection:null, view:null,
  panel:'channels', drawerOpen:true,
};

// ---------- 3. Stats helpers ----------
const mean=a=>a.reduce((s,v)=>s+v,0)/a.length;
const std =a=>{const m=mean(a);return Math.sqrt(a.reduce((s,v)=>s+(v-m)*(v-m),0)/(a.length-1||1));};
function pearson(x,y){const mx=mean(x),my=mean(y);let sxy=0,sx=0,sy=0;
  for(let i=0;i<x.length;i++){const dx=x[i]-mx,dy=y[i]-my;sxy+=dx*dy;sx+=dx*dx;sy+=dy*dy;}
  return sxy/Math.sqrt(sx*sy||1);}
function rankOf(a){const idx=a.map((v,i)=>[v,i]).sort((p,q)=>p[0]-q[0]);const r=new Array(a.length);
  for(let i=0;i<idx.length;i++)r[idx[i][1]]=i+1;return r;}
const spearman=(x,y)=>pearson(rankOf(x),rankOf(y));
function olsFit(x,y){const mx=mean(x),my=mean(y);let sxy=0,sxx=0;
  for(let i=0;i<x.length;i++){sxy+=(x[i]-mx)*(y[i]-my);sxx+=(x[i]-mx)*(x[i]-mx);}
  const slope=sxy/(sxx||1),intercept=my-slope*mx;return {slope,intercept,predict:xv=>slope*xv+intercept};}
function theilSen(x,y){const slopes=[];const n=x.length;const step=Math.max(1,Math.floor(n*n/4000));let c=0;
  for(let i=0;i<n;i++)for(let j=i+1;j<n;j++){if((c++%step))continue;const dx=x[j]-x[i];
    if(Math.abs(dx)<1e-9)continue;slopes.push((y[j]-y[i])/dx);}
  slopes.sort((a,b)=>a-b);const slope=slopes[Math.floor(slopes.length/2)]||0;
  const inter=[];for(let i=0;i<n;i++)inter.push(y[i]-slope*x[i]);inter.sort((a,b)=>a-b);
  const intercept=inter[Math.floor(inter.length/2)]||0;return {slope,intercept,predict:xv=>slope*xv+intercept};}
function polyFit(x,y,deg){const m=deg+1;const A=Array.from({length:m},()=>new Array(m).fill(0));const b=new Array(m).fill(0);
  const pw=xv=>{const p=[1];for(let d=1;d<=2*deg;d++)p.push(p[d-1]*xv);return p;};
  for(let k=0;k<x.length;k++){const p=pw(x[k]);for(let i=0;i<m;i++){for(let j=0;j<m;j++)A[i][j]+=p[i+j];b[i]+=p[i]*y[k];}}
  for(let i=0;i<m;i++){let piv=i;for(let r=i+1;r<m;r++)if(Math.abs(A[r][i])>Math.abs(A[piv][i]))piv=r;
    [A[i],A[piv]]=[A[piv],A[i]];[b[i],b[piv]]=[b[piv],b[i]];
    for(let r=0;r<m;r++){if(r===i)continue;const f=A[r][i]/(A[i][i]||1e-9);
      for(let c=i;c<m;c++)A[r][c]-=f*A[i][c];b[r]-=f*b[i];}}
  const co=A.map((row,i)=>b[i]/(row[i]||1e-9));
  return {coef:co,predict:xv=>{let s=0,p=1;for(let d=0;d<m;d++){s+=co[d]*p;p*=xv;}return s;}};}
function loessPredictor(x,y,frac=0.35){
  const pts=x.map((xv,i)=>[xv,y[i]]).sort((a,b)=>a[0]-b[0]);
  const xs=pts.map(p=>p[0]),ys=pts.map(p=>p[1]);const k=Math.max(4,Math.floor(frac*xs.length));
  return xv=>{const d=xs.map(v=>Math.abs(v-xv));
    const order=d.map((v,i)=>[v,i]).sort((a,b)=>a[0]-b[0]).slice(0,k);const hmax=order[order.length-1][0]||1;
    let sw=0,swx=0,swy=0,swxx=0,swxy=0;
    for(const [dist,i] of order){const u=dist/hmax;const w=Math.pow(1-u*u*u,3);
      sw+=w;swx+=w*xs[i];swy+=w*ys[i];swxx+=w*xs[i]*xs[i];swxy+=w*xs[i]*ys[i];}
    const denom=sw*swxx-swx*swx;if(Math.abs(denom)<1e-9)return swy/sw;
    const b=(sw*swxy-swx*swy)/denom;const a=(swy-b*swx)/sw;return a+b*xv;};}

// ---------- 4. DOM ----------
const $=id=>document.getElementById(id);
const plot=$('plot'),overlay=$('overlay'),ctx=plot.getContext('2d'),octx=overlay.getContext('2d');
const wrap=$('plotWrap'),tooltip=$('tooltip'),readout=$('readout'),hintEl=$('hint');
let PAD={l:64,r:18,t:18,b:48},W=0,H=0,DPR=window.devicePixelRatio||1;
const getCSS=v=>getComputedStyle(document.documentElement).getPropertyValue(v).trim();

// ---------- 5. Accessors ----------
function activeRows(){ return DATA.map((d,i)=>({...d,_i:i})); }
function seriesGroups(){
  if(ST.groupBy==='none')return [{key:'all',name:'All data',color:'#4ea1ff',rows:activeRows()}];
  return SERIES.map(s=>({...s,rows:activeRows().filter(r=>r.series===s.key)}));
}
function dataBounds(rows){let x0=Infinity,x1=-Infinity,y0=Infinity,y1=-Infinity;
