  const dx=invX(mx),dy=invY(my);
  if(mx>PAD.l&&mx<W-PAD.r&&my>PAD.t&&my<H-PAD.b)readout.innerHTML=`${ST.xCol}: <b>${fmt(dx)}</b> &nbsp; ${ST.yCol}: <b>${fmt(dy)}</b>`;
  if(dragSel){dragSel.pts.push([mx,my]);drawOverlay();return;}
  let best=null,bestD=120;
  for(const r of activeRows()){const X=tx(r[ST.xCol]),Y=ty(r[ST.yCol]);const d=(X-mx)**2+(Y-my)**2;if(d<bestD){bestD=d;best=r;}}
  hoverPt=best;drawOverlay();
  if(best){tooltip.style.display='block';tooltip.style.left=(tx(best[ST.xCol])+12)+'px';tooltip.style.top=(ty(best[ST.yCol])-10)+'px';
    tooltip.innerHTML=`<div><b>${SERIES.find(s=>s.key===best.series)?.name||'Row'}</b></div>
      <div><span class="k">${ST.xCol}:</span> ${best[ST.xCol].toFixed(1)}</div>
      <div><span class="k">${ST.yCol}:</span> ${best[ST.yCol].toFixed(2)}</div>
      ${ST.colorBy!=='series'&&ST.colorBy!=='none'?`<div><span class="k">${ST.colorBy}:</span> ${best[ST.colorBy].toFixed(1)}</div>`:''}`;}
  else tooltip.style.display='none';});
overlay.addEventListener('mousedown',e=>{if(!ST.selMode)return;const rect=overlay.getBoundingClientRect();
  dragSel={pts:[[e.clientX-rect.left,e.clientY-rect.top]]};});
window.addEventListener('mouseup',()=>{if(dragSel&&dragSel.pts.length>3){const sel=new Set();
  for(const r of activeRows()){if(pointInPoly(tx(r[ST.xCol]),ty(r[ST.yCol]),dragSel.pts))sel.add(r._i);}
  ST.selection=sel.size?sel:null;}dragSel=null;drawOverlay();draw();});
overlay.addEventListener('mouseleave',()=>{hoverPt=null;tooltip.style.display='none';drawOverlay();});
function pointInPoly(x,y,poly){let inside=false;for(let i=0,j=poly.length-1;i<poly.length;j=i++){
  const xi=poly[i][0],yi=poly[i][1],xj=poly[j][0],yj=poly[j][1];
  if(((yi>y)!=(yj>y))&&(x<(xj-xi)*(y-yi)/(yj-yi)+xi))inside=!inside;}return inside;}
function drawOverlay(){octx.clearRect(0,0,W,H);
  if(hoverPt){const X=tx(hoverPt[ST.xCol]),Y=ty(hoverPt[ST.yCol]);
    octx.strokeStyle='rgba(78,161,255,.35)';octx.lineWidth=1;octx.setLineDash([3,3]);
    octx.beginPath();octx.moveTo(X,PAD.t);octx.lineTo(X,H-PAD.b);octx.moveTo(PAD.l,Y);octx.lineTo(W-PAD.r,Y);octx.stroke();octx.setLineDash([]);
    octx.beginPath();octx.arc(X,Y,7,0,2*Math.PI);octx.strokeStyle='#fff';octx.lineWidth=1.5;octx.stroke();}
  if(dragSel){const p=dragSel.pts;octx.beginPath();octx.moveTo(p[0][0],p[0][1]);for(const pt of p)octx.lineTo(pt[0],pt[1]);octx.closePath();
    octx.fillStyle='rgba(78,161,255,.12)';octx.fill();octx.strokeStyle=getCSS('--accent');octx.lineWidth=1.5;octx.setLineDash([4,3]);octx.stroke();octx.setLineDash([]);}}

// ---------- 10. Rail / drawer toggling (Time-Graphics style) ----------
function selectPanel(name){
  if(ST.drawerOpen && ST.panel===name){ // clicking active button collapses
    ST.drawerOpen=false; $('drawer').classList.add('collapsed');
    $('rail').querySelectorAll('button').forEach(b=>b.classList.remove('active'));
    return;
  }
  ST.panel=name; ST.drawerOpen=true; $('drawer').classList.remove('collapsed');
  $('rail').querySelectorAll('button').forEach(b=>b.classList.toggle('active',b.dataset.panel===name));
  $('drawer').querySelectorAll('.panel').forEach(p=>p.classList.toggle('active',p.dataset.panel===name));
  const titles={channels:'Channels',axes:'Axes',encoding:'Encoding',markers:'Markers',density:'Density',trend:'Trend / Regression',reference:'Reference Lines'};
  $('drawerTitle').textContent=titles[name]||name;
  setTimeout(resize,140); // canvas re-fit after width transition
}
$('rail').querySelectorAll('button').forEach(b=>b.addEventListener('click',()=>selectPanel(b.dataset.panel)));
$('drawerX').addEventListener('click',()=>{ST.drawerOpen=false;$('drawer').classList.add('collapsed');
  $('rail').querySelectorAll('button').forEach(b=>b.classList.remove('active'));setTimeout(resize,140);});

// ---------- 11. Control bindings ----------
function bindSelect(id,key,after){const el=$(id);el.value=ST[key];
  el.addEventListener('change',()=>{ST[key]=el.value;after&&after();draw();});}
function setupAxisSelects(){for(const id of ['xCol','yCol']){const el=$(id);
  el.innerHTML=CHANNELS.map(c=>`<option ${c===ST[id]?'selected':''}>${c}</option>`).join('');}}
setupAxisSelects();
bindSelect('xCol','xCol',resetView);bindSelect('yCol','yCol',resetView);
bindSelect('groupBy','groupBy');bindSelect('colorBy','colorBy');bindSelect('sizeBy','sizeBy');
bindSelect('shape','shape');bindSelect('densMode','densMode');bindSelect('regModel','regModel');
$('ptSize').addEventListener('input',e=>{ST.ptSize=+e.target.value;$('ptSizeV').textContent=e.target.value;draw();});
$('opacity').addEventListener('input',e=>{ST.opacity=e.target.value/100;$('opacityV').textContent=e.target.value+'%';draw();});
$('usl').addEventListener('input',e=>{ST.usl=+e.target.value;draw();});
for(const [id,key] of [['xLog','xLog'],['yLog','yLog'],['ellipse','ellipse'],['ciBand','ciBand'],['perSeries','perSeries'],['markOutliers','markOutliers']])
  $(id).addEventListener('change',e=>{ST[key]=e.target.checked;draw();});
$('btnSelMode').addEventListener('click',()=>{ST.selMode=!ST.selMode;$('btnSelMode').classList.toggle('active',ST.selMode);
  hintEl.style.display=ST.selMode?'block':'none';overlay.style.cursor=ST.selMode?'cell':'crosshair';});
$('btnClearSel').addEventListener('click',()=>{ST.selection=null;draw();drawOverlay();});
$('btnReset').addEventListener('click',resetView);
document.querySelectorAll('.tab').forEach(t=>t.addEventListener('click',()=>{
  document.querySelectorAll('.tab').forEach(x=>x.classList.remove('active'));t.classList.add('active');
  for(const n of ['stats','insights'])$('tab-'+n).style.display=(n===t.dataset.tab)?'block':'none';}));
function resetView(){const all=[];seriesGroups().forEach(g=>all.push(...g.rows));ST.view=dataBounds(all);draw();}

// ---------- 12. Init ----------
resetView();
new ResizeObserver(resize).observe(wrap);
resize();
</script>
